# Optional payload field-name metadata (offset-ordered), for NumPy structured dtypes.
# Only emitted when payloadSpec is not mask-based and offsets are contiguous [0..count-1].
<#= ToSnakeCase(deviceName, allCaps:true) #>_FIELDS: dict[<#= deviceName #>Registers, tuple[str, ...]] = {
<#
    foreach (var registerMetadata in publicRegisters)
    {
        var regName = registerMetadata.Key;
        var reg = registerMetadata.Value;

        if (reg.PayloadSpec == null || reg.PayloadSpec.Count == 0)
            continue;

        var anyMasked = reg.PayloadSpec.Values.Any(m => m.Mask != null);
        if (anyMasked)
            continue;

        var members = new List<(string Name, int Offset)>();
        int memberIndex = 0;
        foreach (var member in reg.PayloadSpec)
        {
            int offset = member.Value.Offset ?? memberIndex;
            members.Add((member.Key, offset));
            memberIndex++;
        }

        int maxOffset = members.Max(m => m.Offset);
        int count = Math.Max(reg.Length > 0 ? reg.Length : 1, maxOffset + 1);

        var ordered = members.OrderBy(m => m.Offset).ToList();

        bool contiguous = ordered.Count == count;
        if (contiguous)
        {
            for (int i = 0; i < ordered.Count; i++)
            {
                if (ordered[i].Offset != i) { contiguous = false; break; }
            }
        }

        if (!contiguous)
            continue;

        var regConst = ToSnakeCase(regName, allCaps:true);
#>
    <#= deviceName #>Registers.<#= regConst #>: (
<#
        for (int i = 0; i < ordered.Count; i++)
        {
#>        "<#= ordered[i].Name #>"<#= (i < ordered.Count - 1 ? "," : "") #>
<#
        }
#>
    ),
<#
    }
#>
}



class <#= deviceName #>(Device[<#= deviceName #>Registers]):
    """
    <#= deviceName #> class for controlling the device.

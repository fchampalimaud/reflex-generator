    def read_<#= ToSnakeCase(regName) #>(self) -> <#= regName #>:
        """
        Reads the <#= regName #> register.

        Returns
        -------
        <#= pyType(interfaceType) #>
            The value stored in the <#= regName #> register
        """
        message = <#= regName #>()
        reply = self.send(message)
        if reply is None:
            raise HarpTimeoutException(self._timeout, message)

        return <#= regName #>(
            reply.payload,
            payload_type=reply.payload_type,
            timestamp=reply.timestamp,
            port=reply.port,
        )

    def read2_<#= ToSnakeCase(regName) #>(self) -> <#= pyType(interfaceType) #>:
        """
        Reads the <#= regName #> register.

        Returns
        -------
        <#= pyType(interfaceType) #>
            The value stored in the <#= regName #> register
        """
        return self.read_reg(<#= deviceName #>Registers.<#= ToSnakeCase(regName, allCaps:true) #>)

<#      if ((reg.Access & RegisterAccess.Write) != 0) { #>
    def write_<#= ToSnakeCase(regName) #>(self, value: <#= pyType(interfaceType) #>) -> <#= regName #>:
        """
        Writes a value to the <#= regName #> register.

        Parameters
        ----------
        value : <#= pyType(interfaceType) #>
            The value to be written to the <#= regName #> register
        """
        message = <#= regName #>(
            message_type=MessageType.WRITE,
            payload=value,
        )
        reply = self.send(message)
        if reply is not None:
            return <#= regName #>(
                reply.payload,
                reply.message_type,
                reply.payload_type,
                timestamp=reply.timestamp,
                port=reply.port,
            )
        return None

    def write2_<#= ToSnakeCase(regName) #>(self, value: <#= pyType(interfaceType) #>) -> <#= pyType(interfaceType) #>:
        """
        Writes a value to the <#= regName #> register.

        Parameters
        ----------
        value : <#= pyType(interfaceType) #>
            The value to be written to the <#= regName #> register
        """
        return self.write_reg(<#= deviceName #>Registers.<#= ToSnakeCase(regName, allCaps:true) #>, value)

